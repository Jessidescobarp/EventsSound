# Copy to .env for local development. Placeholders only: never commit real values.

# --- Backend settings (read by backend/src/eventssound/config.py) ---
APP_ENV=local
# Use 127.0.0.1, not localhost (Windows + Docker Desktop IPv6 quirk).
DATABASE_URL=postgresql+psycopg://eventssound:eventssound@127.0.0.1:5432/eventssound
# Comma-separated exact origins, scheme included, no trailing slash.
CORS_ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# --- Local Postgres (docker-compose.yml) ---
POSTGRES_USER=eventssound
POSTGRES_PASSWORD=eventssound
POSTGRES_DB=eventssound
# Host port for the db container. Change it (and the URLs) if 5432 is taken.
POSTGRES_PORT=5432

# --- Tests ---
# Opt-in: DB tests skip when unset and FAIL when set but unreachable.
DATABASE_URL_TEST=postgresql+psycopg://eventssound:eventssound@127.0.0.1:5432/eventssound

# --- Frontend (public: embedded in the browser bundle, never put secrets here) ---
VITE_API_BASE_URL=http://localhost:8000

# --- Embeddings (vector search; off = keyword search only) ---
EMBEDDING_PROVIDER=off
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1024
OPENROUTER_API_KEY=

CHAT_ENABLED=true
LLM_PROVIDER=replay
LLM_MODEL=
LLM_INPUT_PRICE_MICRO_USD_PER_MTOK=0
LLM_OUTPUT_PRICE_MICRO_USD_PER_MTOK=0
LLM_DAILY_TOKEN_CAP=100000
LLM_DAILY_COST_CAP_MICRO_USD=1000000
CHAT_RATE_LIMIT_PER_MINUTE=5
TRUSTED_PROXY_HOPS=0